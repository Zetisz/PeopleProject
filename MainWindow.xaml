<Window x:Class="PeopleProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PeopleProject"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Image x:Name="img" HorizontalAlignment="Center" VerticalAlignment="Top" Height="120" Width="200"/>
        <TextBox x:Name="tb" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="50" FontSize="30" Margin="0, -120, 0, 0" VerticalContentAlignment="Center"></TextBox>
        <Button x:Name="btn" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="50"  FontSize="24" Click="btn_Click">Hozzáadás</Button>
        <TextBox x:Name="tbMin" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="50" FontSize="30" Margin="0, 140, 150, 0" VerticalContentAlignment="Center" Text="0"></TextBox>
        <TextBox x:Name="tbMax" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="50" FontSize="30" Margin="150, 140, 0, 0" VerticalContentAlignment="Center" Text="100"></TextBox>
        <Button x:Name="btnAtlag" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="50"  FontSize="24" Margin="0, 280, 0, 0" Click="btnAtlag_Click">Átlagszámítás</Button>
        <Label x:Name="lbl" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="30"></Label>
    </Grid>
</Window>
